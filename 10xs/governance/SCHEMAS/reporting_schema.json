              "required": [
                "artifactId",
                "version"
              ],
              "additionalProperties": false
            },
            "directionRef": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string"
                },
                "version": {
                  "type": "number"
                }
              },
              "required": [
                "artifactId",
                "version"
              ],
              "additionalProperties": false
            }
