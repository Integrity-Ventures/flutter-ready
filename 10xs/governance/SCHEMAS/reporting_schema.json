                          },
                          "estimatedHours": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "parentStoryId": {
                            "type": "string"
                          },
                          "targetFiles": {
                            "default": [],
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
