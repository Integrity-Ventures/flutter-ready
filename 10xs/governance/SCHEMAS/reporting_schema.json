          "required": [
            "kernelVersion",
            "artifactVersion",
            "generatorVersion",
            "generatedAt",
            "totalEpics",
            "totalStories",
            "domainSummary"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "epics",
        "metadata"
      ],
      "additionalProperties": false
