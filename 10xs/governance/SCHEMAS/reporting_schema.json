                    "dependencies": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "status": {
                      "default": "pending",
                      "type": "string",
                      "enum": [
                        "pending",
                        "in_progress",
                        "completed",
                        "blocked"
