# 10xs and MCP client config: these hold board credentials. Never commit them.
.10xs.json
.mcp.json

# Secrets
.env
.env.*

# Dart
.dart_tool/
build/
# This is a package, so its lock file isn't committed.
pubspec.lock
# Except the e5-s1 fixture app: an app's lock file is meant to be
# committed, and this one is the known-blocker fixture the Action's
# verify workflow checks against.
!/fixtures/sample_app/pubspec.lock

# Editors and OS
.idea/
.vscode/
.DS_Store

# 10xs sync — never commit your sync token/state (auto-added by 10xs-sync)
.10xs.state.json

# 10xs runtime scratch — never commit session logs/output (auto-added by 10xs)
.10xs/
